#!/usr/bin/env python3
"""cc-session-resumer-open — open a Claude session in a new Warp tab. Called by cc-session-resumer via fzf execute."""
import subprocess
import sys
from pathlib import Path


def shlex_quote(s: str) -> str:
    return "'" + s.replace("'", "'\\''") + "'"


def _find_session_project_dir(session_id: str) -> str:
    """Find the ~/.claude/projects/<encoded>/ dir that owns this session."""
    projects = Path.home() / ".claude" / "projects"
    for d in projects.iterdir():
        if d.is_dir() and (d / f"{session_id}.jsonl").exists():
            return str(d)
    return ""


def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    session_id = sys.argv[1]
    project_path = sys.argv[2] if len(sys.argv) > 2 else ""

    if project_path and Path(project_path).exists():
        cd_path = project_path
    else:
        # Original path gone (e.g. deleted worktree) — find the session's encoded project dir
        # so claude --resume can locate the .jsonl from the right project context
        cd_path = _find_session_project_dir(session_id) or str(Path.home())

    cmd = f"cd {shlex_quote(cd_path)} && claude --resume {session_id}"

    subprocess.run(["pbcopy"], input=cmd, text=True, check=True)
    script = """
tell application "Warp"
  activate
end tell
tell application "System Events"
  tell process "Warp"
    keystroke "t" using command down
    delay 0.4
    keystroke "v" using command down
    delay 0.1
    keystroke return
  end tell
end tell
"""
    subprocess.run(["osascript", "-e", script], check=True)
    print(f"Opened {session_id[:8]}…")


if __name__ == "__main__":
    main()
