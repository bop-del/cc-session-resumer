#!/usr/bin/env python3
"""cc-session-resumer-open — open a Claude session in a new terminal tab/window.

Called by cc-session-resumer via fzf execute.
Terminal backend is controlled by $CC_SESSION_RESUMER_TERMINAL (default: ghostty).
"""
import os
import subprocess
import sys
from pathlib import Path


def shlex_quote(s: str) -> str:
    return "'" + s.replace("'", "'\\''") + "'"


def _find_session_project_dir(session_id: str) -> str:
    """Find the ~/.claude/projects/<encoded>/ dir that owns this session."""
    projects = Path.home() / ".claude" / "projects"
    for d in projects.iterdir():
        if d.is_dir() and (d / f"{session_id}.jsonl").exists():
            return str(d)
    return ""


def open_in_ghostty(cmd: str) -> None:
    """Open a new Ghostty window running cmd (macOS: open -na Ghostty.app)."""
    subprocess.run(["open", "-na", "Ghostty.app", "--args", "-e", "zsh", "-c", cmd], check=True)


def open_in_warp(cmd: str) -> None:
    """Open a new Warp tab running cmd (AppleScript + pbcopy)."""
    subprocess.run(["pbcopy"], input=cmd, text=True, check=True)
    script = """
tell application "Warp"
  activate
end tell
tell application "System Events"
  tell process "Warp"
    keystroke "t" using command down
    delay 0.4
    keystroke "v" using command down
    delay 0.1
    keystroke return
  end tell
end tell
"""
    subprocess.run(["osascript", "-e", script], check=True)


def open_in_terminal(cmd: str) -> None:
    """Dispatch to the configured terminal backend."""
    terminal = os.environ.get("CC_SESSION_RESUMER_TERMINAL", "ghostty").lower()
    if terminal == "warp":
        open_in_warp(cmd)
    elif terminal == "ghostty":
        open_in_ghostty(cmd)
    else:
        # Fallback: copy to clipboard and print
        subprocess.run(["pbcopy"], input=cmd, text=True, check=False)
        print(f"Unknown terminal '{terminal}'. Command copied to clipboard:")
        print(cmd)


def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    session_id = sys.argv[1]
    project_path = sys.argv[2] if len(sys.argv) > 2 else ""

    if project_path and Path(project_path).exists():
        cd_path = project_path
    else:
        # Original path gone (e.g. deleted worktree) — find the session's encoded project dir
        cd_path = _find_session_project_dir(session_id) or str(Path.home())

    cmd = f"cd {shlex_quote(cd_path)} && claude --resume {session_id}"
    open_in_terminal(cmd)
    print(f"Opened {session_id[:8]}…")


if __name__ == "__main__":
    main()
