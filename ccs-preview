#!/usr/bin/env python3
"""
ccs-preview — fzf preview pane for ccs session picker.
Usage: ccs-preview <session_id>
"""
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


def fmt_date(iso: str) -> str:
    try:
        dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        d = (now - dt).days
        ts = dt.strftime("%Y-%m-%d %H:%M")
        if d == 0:
            return f"{ts} (today)"
        elif d == 1:
            return f"{ts} (yesterday)"
        else:
            return f"{ts} ({d}d ago)"
    except Exception:
        return iso[:16] if iso else "?"


def fmt_dur(created: str, modified: str) -> str:
    try:
        tc = datetime.fromisoformat(created.replace("Z", "+00:00"))
        tm = datetime.fromisoformat(modified.replace("Z", "+00:00"))
        s = int((tm - tc).total_seconds())
        if s > 3600:
            return f"{s // 3600}h {(s % 3600) // 60}m"
        elif s > 60:
            return f"{s // 60}m"
        else:
            return f"{s}s"
    except Exception:
        return "?"


def extract_text(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for c in content:
            if isinstance(c, dict):
                t = c.get("text", "")
                if t:
                    parts.append(t)
        return " ".join(parts)
    return ""


def clean(text: str) -> str:
    text = re.sub(r"<[^>]+>", "", text)
    return text.strip()


def get_session_stats(jsonl_path: Path) -> dict:
    """Extract token usage, models, and tool use counts from a session."""
    stats = {
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_read": 0,
        "cache_create": 0,
        "models": {},
        "tools": {},
    }
    try:
        for line in jsonl_path.read_text().splitlines():
            try:
                m = json.loads(line)
                if m.get("type") != "assistant":
                    continue
                msg = m.get("message", {})
                model = msg.get("model", "")
                if model:
                    stats["models"][model] = stats["models"].get(model, 0) + 1
                usage = msg.get("usage", {})
                stats["input_tokens"] += usage.get("input_tokens", 0)
                stats["output_tokens"] += usage.get("output_tokens", 0)
                stats["cache_read"] += usage.get("cache_read_input_tokens", 0)
                stats["cache_create"] += usage.get("cache_creation_input_tokens", 0)
                for c in msg.get("content", []):
                    if isinstance(c, dict) and c.get("type") == "tool_use":
                        name = c.get("name", "?")
                        stats["tools"][name] = stats["tools"].get(name, 0) + 1
            except (json.JSONDecodeError, KeyError, TypeError):
                continue
    except OSError:
        pass
    return stats


def fmt_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n/1_000:.1f}k"
    return str(n)


def short_model(model: str) -> str:
    """Shorten model ID to readable name."""
    model = model.lower()
    if "opus-4" in model:      return "opus-4"
    if "sonnet-4-6" in model:  return "sonnet-4.6"
    if "sonnet-4-5" in model:  return "sonnet-4.5"
    if "haiku-4-5" in model:   return "haiku-4.5"
    if "opus" in model:        return "opus"
    if "sonnet" in model:      return "sonnet"
    if "haiku" in model:       return "haiku"
    return model[:20]


def get_user_prompts(jsonl_path: Path, max_prompts: int = 8) -> list[tuple[str, str]]:
    """Extract user/human prompts from jsonl, newest first. Returns [(hh:mm, text), ...]."""
    prompts = []
    try:
        lines = jsonl_path.read_text().splitlines()
        for line in lines:
            try:
                msg = json.loads(line)
                if msg.get("type") not in ("human", "user"):
                    continue
                content = msg.get("message", {}).get("content", "")
                text = clean(extract_text(content))
                if not text:
                    continue
                if text in ("User Exited Session",):
                    continue
                if text.startswith("Base directory for this skill:"):
                    continue
                if text.startswith("Caveat: The messages below were generated"):
                    continue
                # Extract HH:MM from timestamp field
                ts_raw = msg.get("timestamp", "")
                try:
                    dt = datetime.fromisoformat(ts_raw.replace("Z", "+00:00"))
                    # Convert to local time for display
                    import time as _time
                    offset = _time.timezone if (_time.daylight == 0) else _time.altzone
                    local_dt = dt.replace(tzinfo=None) - __import__("datetime").timedelta(seconds=-offset)
                    hhmm = dt.astimezone().strftime("%H:%M")
                except Exception:
                    hhmm = "--:--"
                prompts.append((hhmm, text))
            except (json.JSONDecodeError, KeyError, TypeError):
                continue
    except OSError:
        pass
    # Newest first, limit
    prompts.reverse()
    return prompts[:max_prompts]


def main():
    if len(sys.argv) < 2:
        print("Usage: ccs-preview <session_id>")
        sys.exit(1)

    sid = sys.argv[1]
    projects = Path.home() / ".claude" / "projects"

    # Use fzf preview pane width if available, else terminal width, else 80
    import os, shutil
    pane_w = int(os.environ.get("FZF_PREVIEW_COLUMNS", 0)) or shutil.get_terminal_size((80, 24)).columns
    wrap_w = max(40, pane_w - 4)  # leave small margin

    # ANSI colors
    W = "\033[0m"
    B = "\033[1m"
    DIM = "\033[2m"
    C = "\033[36m"
    Y = "\033[33m"
    G = "\033[32m"
    M = "\033[35m"
    R = "\033[31m"

    found = None
    jsonl_path = None
    crashed = False  # set explicitly based on source

    # Search index files
    for p in projects.iterdir():
        if not p.is_dir():
            continue
        idx = p / "sessions-index.json"
        if idx.exists():
            try:
                data = json.loads(idx.read_text())
                for e in data.get("entries", []):
                    if e.get("sessionId") == sid:
                        found = e
                        jf = p / f"{sid}.jsonl"
                        if jf.exists():
                            jsonl_path = jf
                            # Crash: last non-system message is from user (no assistant response)
                            try:
                                lines_all = jf.read_text().strip().splitlines()
                                convo = []
                                for l in lines_all:
                                    try:
                                        m = json.loads(l)
                                        if m.get("type") in ("user", "human", "assistant"):
                                            convo.append(m)
                                    except json.JSONDecodeError:
                                        pass
                                crashed = bool(convo) and convo[-1].get("type") in ("user", "human")
                            except (OSError, json.JSONDecodeError):
                                crashed = False
                        else:
                            crashed = False
                        break
            except (json.JSONDecodeError, OSError):
                pass
        if found:
            break

    # Fallback: find .jsonl directly (not in any index)
    if not found:
        for p in projects.iterdir():
            if not p.is_dir():
                continue
            jf = p / f"{sid}.jsonl"
            if jf.exists():
                jsonl_path = jf
                try:
                    lines = [l for l in jf.read_text().splitlines() if l.strip()]
                    parsed = []
                    for l in lines:
                        try:
                            parsed.append(json.loads(l))
                        except json.JSONDecodeError:
                            pass
                    cwd = next((m.get("cwd", "") for m in parsed if m.get("cwd")), "")
                    mc = sum(1 for m in parsed if m.get("type") in ("human", "user", "assistant"))
                    mt = datetime.fromtimestamp(jf.stat().st_mtime, tz=timezone.utc).isoformat()
                    ct = datetime.fromtimestamp(jf.stat().st_ctime, tz=timezone.utc).isoformat()
                    fp_raw = ""
                    for m in parsed:
                        if m.get("type") in ("human", "user"):
                            content = m.get("message", {}).get("content", "")
                            fp_raw = clean(extract_text(content))
                            if fp_raw:
                                break
                    # Crash for unindexed: last conversation message should be from assistant
                    convo = [m for m in parsed if m.get("type") in ("user", "human", "assistant")]
                    crashed = bool(convo) and convo[-1].get("type") != "assistant"
                    found = {
                        "sessionId": sid,
                        "summary": fp_raw[:120],
                        "firstPrompt": fp_raw,
                        "messageCount": mc,
                        "created": ct,
                        "modified": mt,
                        "projectPath": cwd,
                        "gitBranch": "",
                    }
                except (OSError, json.JSONDecodeError):
                    pass
                break

    if not found:
        print(f"{R}Session not found: {sid}{W}")
        sys.exit(0)

    e = found
    summary = clean(e.get("summary", "") or e.get("firstPrompt", "") or "No summary")
    summary = summary.split("\n")[0].strip()
    proj = e.get("projectPath", "") or "unknown"
    proj_short = proj.split("/")[-1] if "/" in proj else proj
    branch = e.get("gitBranch", "") or ""
    mc = e.get("messageCount", 0)
    created = e.get("created", "")
    modified = e.get("modified", "")
    sid_full = e.get("sessionId", "")

    # ── Title (wraps to 2 lines, word-aware, hard-breaks long tokens) ──────────
    title_words = summary.split()
    title_lines = []
    tline = ""
    for w in title_words:
        # Hard-break tokens longer than pane_w
        while len(w) > pane_w:
            space_left = pane_w - len(tline) - (1 if tline else 0)
            if space_left > 4:
                chunk = w[:space_left]
                tline = (tline + " " + chunk).strip() if tline else chunk
                w = w[space_left:]
            title_lines.append(tline)
            tline = ""
        if len(tline) + len(w) + (1 if tline else 0) > pane_w:
            if tline:
                title_lines.append(tline)
            tline = w
        else:
            tline = (tline + " " + w).strip() if tline else w
    if tline:
        title_lines.append(tline)
    title_lines = title_lines[:2]  # max 2 lines

    for tl in title_lines:
        print(f"{B}{C}{tl}{W}")
    print()

    # ── Project & branch — with [CRASHED] right-aligned on Project line ──────
    crashed_tag = f"{R}[CRASHED]{W}" if crashed else ""
    proj_label = f"{Y}Project:{W}  {proj_short}"
    if crashed_tag:
        # Right-align [CRASHED] — strip ANSI for length calc
        label_len = len(f"Project:  {proj_short}")
        tag_len = len("[CRASHED]")
        pad = max(1, pane_w - label_len - tag_len)
        print(f"{proj_label}{' ' * pad}{crashed_tag}")
    else:
        print(proj_label)
    # Truncate path from left if too long, keeping the meaningful end
    path_avail = pane_w - 9  # "Path:    " = 9 chars
    proj_display = proj if len(proj) <= path_avail else "…" + proj[-(path_avail - 1):]
    print(f"{DIM}Path:    {proj_display}{W}")
    if branch:
        print(f"{M}Branch:  {branch}{W}")
    print()

    # ── Stats ───────────────────────────────────────────────────────────────
    print(f"{G}Messages:{W} {mc}  │  {G}Duration:{W} {fmt_dur(created, modified)}")
    print(f"{DIM}Created:  {fmt_date(created)}{W}")
    print(f"{DIM}Modified: {fmt_date(modified)}{W}")
    print(f"{DIM}ID: {sid_full}{W}")
    resume_cmd = f"claude --resume {sid_full}"
    print(f"{DIM}▶ {W}{resume_cmd}")
    print()

    # ── Token & model stats ──────────────────────────────────────────────────
    if jsonl_path:
        stats = get_session_stats(jsonl_path)
        total_tok = stats["input_tokens"] + stats["output_tokens"]
        if total_tok > 0 or stats["models"] or stats["tools"]:
            sep_s = "─" * (pane_w - 10)  # "── Stats " = 9 chars
            print(f"{G}── Stats {sep_s}{W}")

            # Models
            if stats["models"]:
                model_str = ", ".join(
                    f"{short_model(m)}" + (f" ×{n}" if n > 1 else "")
                    for m, n in sorted(stats["models"].items(), key=lambda x: -x[1])
                )
                print(f"Model:   {model_str}")

            # Tokens
            if total_tok > 0:
                inp  = fmt_tokens(stats["input_tokens"])
                out  = fmt_tokens(stats["output_tokens"])
                cr   = fmt_tokens(stats["cache_read"])
                cc   = fmt_tokens(stats["cache_create"])
                print(f"Tokens:  {G}↑{W}{inp} in  {G}↓{W}{out} out  {DIM}cache {cr} read / {cc} new{W}")

            # Top tools
            if stats["tools"]:
                top = sorted(stats["tools"].items(), key=lambda x: -x[1])[:6]
                tool_str = "  ".join(f"{name}({n})" for name, n in top)
                print(f"Tools:   {DIM}{tool_str}{W}")
            print()

    # ── User prompts (newest first, with HH:MM) ──────────────────────────────
    if jsonl_path:
        prompts = get_user_prompts(jsonl_path, max_prompts=8)
        if prompts:
            # Separator exactly pane_w chars wide
            sep_inner = "─" * (pane_w - 16)  # "── Your prompts " = 16 chars
            print(f"{C}── Your prompts {sep_inner}{W}")
            for hhmm, p in prompts:
                # Prefix: "HH:MM  " = 7 chars
                prefix_len = 7
                avail = wrap_w - prefix_len
                words = p.split()
                lines_out = []
                line = ""
                for w in words:
                    # Hard-break tokens longer than available width
                    while len(w) > avail:
                        space_left = avail - len(line) - (1 if line else 0)
                        if space_left > 4:
                            chunk = w[:space_left]
                            line = (line + " " + chunk).strip() if line else chunk
                            w = w[space_left:]
                        lines_out.append(line)
                        line = ""
                    if len(line) + len(w) + (1 if line else 0) > avail:
                        if line:
                            lines_out.append(line)
                        line = w
                    else:
                        line = (line + " " + w).strip() if line else w
                if line:
                    lines_out.append(line)

                indent = " " * prefix_len
                for j, text in enumerate(lines_out[:4]):
                    if j == 0:
                        print(f"{DIM}{hhmm}{W}  {text}")
                    else:
                        print(f"{indent}{text}")
                if len(lines_out) > 4:
                    print(f"{indent}…")
                print()


if __name__ == "__main__":
    main()
